{"nodes": [{"id": "_claude_skills_laravel_best_practices_rules_security_security_best_practices", "label": "Security Best Practices (Laravel rules)", "file_type": "document", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_security_mass_assignment_fillable", "label": "Mass assignment control ($fillable/$guarded)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laravel models guard all attributes by default; $guarded = [] opts out of that protection and must never receive untrusted request data."}, {"id": "_claude_skills_laravel_best_practices_rules_security_authorize_protected_actions", "label": "Authorize protected actions (gates/policies/form requests)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication alone does not establish permission, and validation is not authorization."}, {"id": "_claude_skills_laravel_best_practices_rules_security_query_parameter_binding", "label": "Bind query parameters (no SQL interpolation)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bindings protect values, not identifiers such as column names or sort directions; map user-selected identifiers to an allow-list."}, {"id": "_claude_skills_laravel_best_practices_rules_security_blade_output_escaping", "label": "Escape output in its context (Blade {{ }})", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The raw echo directive is safe only for content sanitized for the exact HTML context; escaping rules differ for HTML, URLs, JavaScript, and CSS."}, {"id": "_claude_skills_laravel_best_practices_rules_security_csrf_protection", "label": "CSRF protection (@csrf / X-XSRF-TOKEN)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes intentionally excluded from CSRF verification, such as validated third-party webhooks, need their own authenticity check."}, {"id": "_claude_skills_laravel_best_practices_rules_security_rate_limit_sensitive_endpoints", "label": "Rate limit sensitive endpoints (RateLimiter::for)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An IP address alone can unfairly group users behind a shared network, while an account identifier alone can enable targeted denial of service."}, {"id": "_claude_skills_laravel_best_practices_rules_security_upload_validation", "label": "Validate and store uploads safely", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mimes rule reads file contents and guesses a MIME type; it does not validate the user-assigned filename extension, so pair it with the extensions rule."}, {"id": "_claude_skills_laravel_best_practices_rules_security_composer_audit", "label": "composer audit dependency audit", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_laravel_best_practices_rules_security_blade_output_escaping", "target": "_claude_skills_testing_best_practices_rules_security_escaping_test", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_laravel_best_practices_rules_security_authorize_protected_actions", "target": "_claude_skills_testing_best_practices_rules_endpoint_tests_policy_level_authorization_test", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_laravel_best_practices_rules_security_upload_validation", "target": "_claude_skills_laravel_best_practices_rules_validation_form_request_extraction", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/laravel-best-practices/rules/security.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
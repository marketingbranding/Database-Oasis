{"nodes": [{"id": "_claude_skills_testing_best_practices_rules_performance_performance_rules", "label": "Test Suite Performance rules (testing skill)", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_testing_best_practices_rules_performance_test_environment_settings", "label": "Test environment settings (BCRYPT_ROUNDS/WithCachedConfig/withoutVite)", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the default BCRYPT_ROUNDS of 12 the hash takes most of the time of each test that signs a user in; measure before changing any setting."}, {"id": "_claude_skills_testing_best_practices_rules_performance_global_fakes_setup", "label": "Global fakes in base TestCase setUp", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One request that reaches the network can slow the whole suite; preventStrayRequests, Sleep::fake, and Exceptions::fake belong in the base setUp."}, {"id": "_claude_skills_testing_best_practices_rules_performance_parallel_paratest", "label": "Parallel runs with ParaTest (php artisan test --parallel)", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parallel run gives each process a separate database; a test that fails only in parallel depends on order, shared records, or a shared resource."}], "edges": [{"source": "_claude_skills_testing_best_practices_rules_performance_pe
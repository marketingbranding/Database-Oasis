{"nodes": [{"id": "_claude_skills_laravel_best_practices_rules_mail_mail_best_practices", "label": "Mail Best Practices (Laravel rules)", "file_type": "document", "source_file": ".claude/skills/laravel-best-practices/rules/mail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_mail_queued_mailable", "label": "Queued mailable (ShouldQueue)", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/mail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_mail_mailable_after_commit", "label": "Mailable afterCommit dispatch", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/mail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A queued mailable dispatched during a transaction can be processed before the commit and reference rolled-back records."}, {"id": "_claude_skills_laravel_best_practices_rules_mail_delivery_mode_assertions", "label": "Delivery mode assertions (assertQueued vs assertSent)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/mail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mailable implementing ShouldQueue is queued even when the call site uses Mail::send(), so assertSent would fail."}, {"id": "_claude_skills_laravel_best_practices_rules_mail_content_delivery_test_separation", "label": "Separate content and delivery mail tests", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/mail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [], "hyperedges": []}
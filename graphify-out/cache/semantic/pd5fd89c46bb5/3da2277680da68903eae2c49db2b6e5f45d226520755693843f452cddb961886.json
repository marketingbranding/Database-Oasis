{"nodes": [{"id": "_claude_skills_laravel_best_practices_rules_http_client_http_client_best_practices", "label": "HTTP Client Best Practices (Laravel rules)", "file_type": "document", "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_http_client_explicit_timeouts", "label": "Explicit HTTP timeouts (connectTimeout/timeout)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default 30-second timeout rarely fits the service, and retries can multiply total elapsed time."}, {"id": "_claude_skills_laravel_best_practices_rules_http_client_retry_idempotency", "label": "Retry only safe operations (idempotency keys)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A retried state-changing request can duplicate the operation unless the remote API supports an idempotency key or equivalent duplicate protection."}, {"id": "_claude_skills_laravel_best_practices_rules_http_client_explicit_error_handling", "label": "Explicit HTTP error handling (throw/successful/notFound)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HTTP client returns responses for 4xx/5xx instead of throwing; inspect expected statuses or call throw() before consuming a success payload."}, {"id": "_claude_skills_laravel_best_practices_rules_http_client_http_fake_testing", "label": "Fake HTTP requests in tests (Http::fake/preventStrayRequests)", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also test timeouts, connection failures, and error responses that the application handles, not only the happy path."}], "edges": [{"source": "_claude_skills_laravel_best_practices_rules_http_client_http_fake_testing", "target": "_claude_skills_testing_best_practices_rules_isolation_outbound_http_testing", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_laravel_best_practices_rules_http_client_explicit_timeouts", "target": "_claude_skills_laravel_best_practices_rules_queue_jobs_retry_after_reservation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/skills/laravel-best-practices/rules/http-client.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
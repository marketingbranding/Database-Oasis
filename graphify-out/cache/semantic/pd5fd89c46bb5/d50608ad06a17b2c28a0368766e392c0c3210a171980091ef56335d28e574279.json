{"nodes": [{"id": "_claude_skills_testing_best_practices_rules_endpoint_tests_endpoint_tests_rules", "label": "Endpoint Tests rules (testing skill)", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_testing_best_practices_rules_endpoint_tests_endpoint_coverage_cases", "label": "Endpoint coverage case matrix", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cover missing/invalid auth, cross-tenant requests, insufficient role, constraint failure, validation failure, and the valid case with response plus persisted state."}, {"id": "_claude_skills_testing_best_practices_rules_endpoint_tests_tenant_isolation_404", "label": "Tenant isolation returns 404 not 403", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 403 confirms that another tenant's record exists; a 404 does not."}, {"id": "_claude_skills_testing_best_practices_rules_endpoint_tests_policy_level_authorization_test", "label": "Test authorization at the policy level", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An HTTP test cannot identify which mechanism refused the request because middleware, a policy, and abort() can all return 403."}, {"id": "_claude_skills_testing_best_practices_rules_endpoint_tests_validation_message_testing", "label": "Validation message testing per rule", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A message that is present but wrong is a defect; assert the text the user gets, not that a rules array contains a string."}], "edges": [{"source": "_claude_skills_testing_best_practices_rules_endpoint_tests_validation_message_testing", "target": "_claude_skills_laravel_best_practices_rules_validation_validation_forms_best_practices", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/testing-best-practices/rules/endpoint-tests.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
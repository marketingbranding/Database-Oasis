{"nodes": [{"id": "_claude_skills_testing_best_practices_rules_test_data_test_data_rules", "label": "Factories and Test Data rules (testing skill)", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_testing_best_practices_rules_test_data_per_test_data_creation", "label": "Each test makes its own data", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records created in setUp() remain in memory until the suite ends; per-test creation keeps setup visible and lets each test choose its factory state."}, {"id": "_claude_skills_testing_best_practices_rules_test_data_factory_states", "label": "Named factory states over raw attributes", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A named state gives the data meaning; a raw attribute array gives only its value."}, {"id": "_claude_skills_testing_best_practices_rules_test_data_data_providers", "label": "Data providers for parameterized cases", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/test-data.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One test function with a branch in the body is two tests in one function; use a provider when setup, body, and assertions stay the same across values."}], "edges": [{"source": "_claude_skills_testing_best_practices_rules_test_data_data_providers", "target": "_claude_skills_testing_best_practices_rules_endpoint_tests_validation_message_testing", "relation": "concep
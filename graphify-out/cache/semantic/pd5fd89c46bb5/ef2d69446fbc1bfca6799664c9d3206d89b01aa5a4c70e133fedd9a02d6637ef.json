{"nodes": [{"id": "_claude_skills_laravel_best_practices_rules_scheduling_task_scheduling_best_practices", "label": "Task Scheduling Best Practices (Laravel rules)", "file_type": "document", "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_scheduling_without_overlapping", "label": "withoutOverlapping lock", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The optional value is the lock expiration time in minutes, not the task timeout; the default is 24 hours, and a too-short expiration can permit overlap."}, {"id": "_claude_skills_laravel_best_practices_rules_scheduling_on_one_server", "label": "onOneServer single-node execution", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scheduler nodes must share the same default cache store, and that store must support atomic locks."}, {"id": "_claude_skills_laravel_best_practices_rules_scheduling_run_in_background", "label": "runInBackground scheduled tasks", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_scheduling_bounded_task_work", "label": "Bound work inside the scheduled task", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The scheduler does not terminate arbitrary tasks at a deadline; bound work via finite chunks, deadline checks, or queue jobs with timeouts."}], "edges": [{"source": "_claude_skills_laravel_best_practices_rules_scheduling_on_one_server", "target": "_claude_skills_laravel_best_practices_rules_queue_jobs_should_be_unique", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/laravel-best-practices/rules/scheduling.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
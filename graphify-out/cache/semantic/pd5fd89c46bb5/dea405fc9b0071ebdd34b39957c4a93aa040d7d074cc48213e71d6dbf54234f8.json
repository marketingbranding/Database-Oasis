{"nodes": [{"id": "_claude_skills_testing_best_practices_rules_isolation_isolation_rules", "label": "Fakes, Mocks, and Determinism rules (testing skill)", "file_type": "document", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_testing_best_practices_rules_isolation_framework_fakes", "label": "Framework fakes for facades", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A framework fake preserves the real code path while a mock replaces the dependency; create fakes inside the test method, not in setUp()."}, {"id": "_claude_skills_testing_best_practices_rules_isolation_outbound_http_testing", "label": "Outbound HTTP testing (Http::preventStrayRequests)", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fake without an endpoint accepts unexpected requests and can hide defects; fake the exact endpoint each test uses."}, {"id": "_claude_skills_testing_best_practices_rules_isolation_time_randomness_control", "label": "Time and randomness control (freezeTime/travelTo)", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_testing_best_practices_rules_isolation_real_database_queries", "label": "Real queries against real test-database records", "file_type": "rationale", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocking the query builder makes the test assert the mock; test application behavior caused by the schema, not the engine's cascade implementation."}, {"id": "_claude_skills_testing_best_practices_rules_isolation_lazily_refresh_database", "label": "LazilyRefreshDatabase over RefreshDatabase", "file_type": "concept", "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test that does not use the database then does not run the migrations."}], "edges": [{"source": "_claude_skills_testing_best_practices_rules_isolation_framework_fakes", "target": "_claude_skills_laravel_best_practices_rules_mail_delivery_mode_assertions", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/testing-best-practices/rules/isolation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
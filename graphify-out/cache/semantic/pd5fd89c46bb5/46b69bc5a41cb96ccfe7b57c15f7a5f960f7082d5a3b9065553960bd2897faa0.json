{"nodes": [{"id": "_claude_skills_laravel_best_practices_rules_migrations_migration_best_practices", "label": "Migration Best Practices (Laravel rules)", "file_type": "document", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_migrations_foreign_key_constrained", "label": "Foreign-key constraints (constrained())", "file_type": "concept", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_laravel_best_practices_rules_migrations_immutable_deployed_migrations", "label": "Deployed migrations are immutable", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing a migration that already ran in production makes fresh installations differ from upgraded installations."}, {"id": "_claude_skills_laravel_best_practices_rules_migrations_index_design_for_queries", "label": "Design indexes for real queries", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A column in WHERE, ORDER BY, or JOIN does not automatically need its own index; base indexes on query patterns, selectivity, and write cost."}, {"id": "_claude_skills_laravel_best_practices_rules_migrations_staged_column_changes", "label": "Stage changes affecting existing rows", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a required or unique column to a populated table needs nullable-first, code that handles both states, bounded backfill, then the constraint."}, {"id": "_claude_skills_laravel_best_practices_rules_migrations_honest_rollbacks", "label": "Honest migration rollbacks (down())", "file_type": "rationale", "source_file": ".claude/skills/laravel-best-practices/rules/migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rollback that drops populated columns or cannot restore transformed data is destructive even if syntactically reversible."}], "edges": [], "hyperedges": []}
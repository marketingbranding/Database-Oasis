{"nodes": [{"id": "_agents_skills_laravel_best_practices_rules_security", "label": "Security Best Practices", "file_type": "document", "source_file": ".agents/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_laravel_best_practices_rules_security_mass_assignment_protection", "label": "Mass assignment protection via $fillable", "file_type": "rationale", "source_file": ".agents/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mass-assignment protection controls which attributes create()/fill()/update() may set; it does not validate values or authorize the operation, and $guarded = [] opts out entirely."}, {"id": "_agents_skills_laravel_best_practices_rules_security_csrf_protection", "label": "CSRF protection in Blade forms", "file_type": "concept", "source_file": ".agents/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_laravel_best_practices_rules_security_rate_limiting", "label": "Rate limiting of sensitive endpoints", "file_type": "rationale", "source_file": ".agents/skills/laravel-best-practices/rules/security.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An IP-only key unfairly groups users behind shared networks while an account-only key enables targeted denial of service, so choose limiter keys deliberately; rate limiting reduces abuse but does not replace authentication or authorization."}, {"id": "_agents_skills_laravel_best_practices_rules_security_authorized_actions", "label": "Authorization of protected actions", "file_type": "rationale", "source_file": ".agents/skills/laravel-best-practices/rules/security.md", "sou